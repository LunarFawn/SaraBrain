# Keep the sdist slim. Only ship source, the SQL schema, the optional C++
# engine source, and essential metadata. Everything heavy (model checkpoints,
# databases, training corpora, papers, docs, benchmarks) is excluded.

include README.md
include LICENSE
include pyproject.toml
include Makefile

# Package data that must travel with the sources.
include src/sara_brain/storage/schema.sql
include src/sara_brain/core/engine.cpp

# --- Exclusions -----------------------------------------------------------

# Never ship compiled artifacts, caches, or editor cruft.
global-exclude *.so
global-exclude *.pyc
global-exclude *.pyo
global-exclude *.pyd
global-exclude *~
global-exclude .DS_Store
prune **/__pycache__

# Large model checkpoints and tensors.
global-exclude *.pt
global-exclude *.pth
global-exclude *.ckpt
global-exclude *.safetensors

# Databases and their SQLite sidecars (WAL/SHM/reverse backups).
global-exclude *.db
global-exclude *.db-wal
global-exclude *.db-shm
global-exclude *.db.*
global-exclude *.reverse
global-exclude *.reverse-*

# Bulk corpora / data dumps.
global-exclude *.jsonl
global-exclude *.log

# Subpackages that are intentionally NOT part of the published package.
prune src/sara_brain/cortex
prune src/sara_brain/agent
prune src/sara_brain/sensory
prune src/sara_brain/teaching
prune src/sara_brain/nlp
prune src/sara_brain/care
prune src/sara_brain/repl
prune src/sara_brain/visualization

# Repo-level directories that should never enter the sdist.
prune data
prune training_data
prune training_docs
prune training_courses_for_cricket.txt
prune models
prune papers
prune benchmarks
prune docs
prune demos
prune scripts
prune tools
prune narrative
prune harness
prune substack
prune feedback_to_anthropic
prune tests
prune .venv
prune .git
prune .pytest_cache
prune .claude
prune .amazonq
